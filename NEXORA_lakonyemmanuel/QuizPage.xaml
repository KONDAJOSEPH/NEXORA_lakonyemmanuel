<Page
    x:Class="NEXORA_lakonyemmanuel.QuizPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NEXORA_lakonyemmanuel"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="White">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Background="#0B1930"
              Padding="30,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Background="#E3BB5F"
                Width="40"
                Height="40"
                CornerRadius="5"
                VerticalAlignment="Center">

                <TextBlock
                    Text="N"
                    FontSize="24"
                    FontWeight="Bold"
                    Foreground="White"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>

            </Border>

            <TextBlock
                Grid.Column="1"
                Text="NEXORA"
                Foreground="White"
                FontSize="30"
                FontWeight="Bold"
                VerticalAlignment="Center"
                Margin="10,0,0,0"/>

            <TextBlock
                Grid.Column="2"
                Text="E-Commerce Training Portal"
                FontSize="18"
                Foreground="White"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>

            <TextBlock
                Grid.Column="3"
                x:Name="txttimeleft"
                Text="Time Left: 00:00"
                FontSize="18"
                FontWeight="Bold"
                Foreground="#E3BB5F"
                VerticalAlignment="Center"/>

        </Grid>

        <ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <StackPanel
                Width="900"
                HorizontalAlignment="Center"
                Margin="40,50,40,40">

                <TextBlock
                    x:Name="txtquestionnumber"
                    Text="Question 1 of 20"
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="CadetBlue"
                    Margin="0,0,0,15"/>

                <ProgressBar
                    x:Name="txtprogress"
                    Minimum="0"
                    Maximum="20"
                    Value="1"
                    Height="8"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,0,50"/>

                <TextBlock
                    Text="QUESTION"
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="#CC9C2D"
                    Margin="0,0,0,15"/>

                <TextBlock
                    x:Name="txtquestion"
                    Text="Here is your question"
                    FontWeight="Bold"
                    FontSize="30"
                    Foreground="#0B1930"
                    TextWrapping="Wrap"
                    Margin="0,0,0,30"/>

                <RadioButton
                    x:Name="radioa"
                    Content="Option 1"
                    GroupName="Answers"
                    FontSize="18"
                    Foreground="#0B1930"
                    Margin="0,10,0,10"/>

                <RadioButton
                    x:Name="radiob"
                    Content="Option 2"
                    GroupName="Answers"
                    FontSize="18"
                    Foreground="#0B1930"
                    Margin="0,10,0,10"/>

                <RadioButton
                    x:Name="radioc"
                    Content="Option 3"
                    GroupName="Answers"
                    FontSize="18"
                    Foreground="#0B1930"
                    Margin="0,10,0,10"/>

                <RadioButton
                    x:Name="radiod"
                    Content="Option 4"
                    GroupName="Answers"
                    FontSize="18"
                    Foreground="#0B1930"
                    Margin="0,10,0,30"/>

                <Button
                    x:Name="btnnextquestion"
                    Content="NEXT QUESTION"
                    Click="btnnextquestion_Click"
                    Background="#CC9C2D"
                    Foreground="White"
                    FontSize="18"
                    FontWeight="Bold"
                    CornerRadius="8"
                    Width="180"
                    Height="48"
                    HorizontalAlignment="Right"
                    Margin="0,30,0,20"/>
                <TextBlock Text="NEXORA. E-Commerce Knowledge assessmet.2026"
                           Foreground="CadetBlue"
                           HorizontalAlignment="Center"
                           FontSize="18"/>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Page>
    
    