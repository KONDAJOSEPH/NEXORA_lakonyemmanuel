<Page
    x:Class="NEXORA_lakonyemmanuel.RegistrationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NEXORA_lakonyemmanuel"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="White">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40*"/>
            <ColumnDefinition Width="60*"/>
        </Grid.ColumnDefinitions>


        <Grid Grid.Column="0"
              Background="#0B1930">

            <StackPanel Margin="50,40,50,40">

               
                <StackPanel Orientation="Horizontal">

                    <Border
                        Background="#E3BB5F"
                        Width="45"
                        Height="45"
                        CornerRadius="5">

                        <TextBlock
                            Text="N"
                            FontSize="24"
                            FontWeight="Bold"
                            Foreground="White"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                    </Border>

                    <TextBlock
                        Text="NEXORA"
                        FontSize="30"
                        FontWeight="Bold"
                        Foreground="White"
                        VerticalAlignment="Center"
                        Margin="15,0,0,0"/>

                </StackPanel>


               
                <StackPanel Margin="0,180,0,0">

                    <TextBlock
                        Text="Create your account"
                        FontSize="46"
                        FontWeight="Bold"
                        Foreground="White"
                        TextWrapping="Wrap"/>

                    <TextBlock
                        Text="Join NEXORA and start shopping for electronics and smart devices"
                        FontSize="18"
                        Foreground="White"
                        TextWrapping="Wrap"
                        Margin="0,15,0,30"/>

                    <TextBlock
                        Text=" Quality electronics"
                        FontSize="18"
                        Foreground="White"
                        Margin="0,8"/>

                    <TextBlock
                        Text=" Secure shopping"
                        FontSize="18"
                        Foreground="White"
                        Margin="0,8"/>

                    <TextBlock
                        Text="  Easy delivery"
                        FontSize="18"
                        Foreground="White"
                        Margin="0,8"/>

                </StackPanel>

            </StackPanel>

        </Grid>


        
        <Grid Grid.Column="1"
              Background="White">

            <ScrollViewer
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">

                <StackPanel
                    Width="560"
                    HorizontalAlignment="Center"
                    Margin="40,40,40,40">


                  
                    <TextBlock
                        Text="Create account"
                        FontSize="30"
                        FontWeight="Bold"
                        Foreground="#0B1930"
                        Margin="0,5,0,5"
                        HorizontalAlignment="Left"/>

                    <TextBlock
                        Text="Enter your details to create your customer account"
                        FontSize="18"
                        Foreground="CadetBlue"
                        TextWrapping="Wrap"
                        Margin="0,0,0,25"/>


                   
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="20">

                        <TextBox
                            x:Name="txtfirstname"
                            Header="First Name"
                            PlaceholderText="First Name"
                            Width="270"/>

                        <TextBox
                            x:Name="txtlastname"
                            Header="Last Name"
                            PlaceholderText="Last Name"
                            Width="270"/>

                    </StackPanel>


                 
                    <TextBox
                        x:Name="txtphonenumber"
                        Header="Phone Number"
                        PlaceholderText="Enter phone number"
                        Margin="0,15,0,0"/>


                   
                    <TextBox
                        x:Name="txtemailaddress"
                        Header="Email Address"
                        PlaceholderText="Enter email address"
                        Margin="0,15,0,0"/>


                   
                    <TextBox
                        x:Name="txtdeliveryaddress"
                        Header="Delivery Address"
                        PlaceholderText="Enter delivery address"
                        Margin="0,15,0,0"/>


                    
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="20"
                        Margin="0,15,0,0">

                        <TextBox
                            x:Name="txtcity"
                            Header="City"
                            PlaceholderText="City"
                            Width="270"/>

                        <TextBox
                            x:Name="txtcountry"
                            Header="Country"
                            PlaceholderText="Uganda"
                            Width="270"/>

                    </StackPanel>


                   
                    <TextBox
                        x:Name="txtusername"
                        Header="Username"
                        PlaceholderText="Choose a username"
                        Margin="0,15,0,0"/>


                  
                    <TextBox
                        x:Name="txtpassword"
                        Header="Password"
                        PlaceholderText="Create a password"
                        Margin="0,15,0,0"/>


                    
                    <TextBox
                        x:Name="txtconfirmpassword"
                        Header="Confirm Password"
                        PlaceholderText="Confirm your password"
                        Margin="0,15,0,0"/>


                   
                    <Button
                        x:Name="btncreateaccount"
                        Content="CREATE ACCOUNT"
                        Background="#CC9C2D"
                        Foreground="White"
                        CornerRadius="8"
                        Height="48"
                        HorizontalAlignment="Left"
                        HorizontalContentAlignment="Center"
                        Margin="0,25,0,10" Click="btncreateaccount_Click"/>


                    
                    <StackPanel
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,10,0,20">

                       

                        <Button
                            x:Name="btnsignin"
                            Content="BACK TO LOGIN" Click="btnbacktologin_Click"
                            Background="Transparent"
                            Foreground="#0B1930"
                            HorizontalAlignment="Left"
                            BorderThickness="0"
                            Margin="0,0,0,0"/>

                    </StackPanel>


                    <TextBlock
                        Text="NEXORA.Online Electronics Store"
                        Foreground="CadetBlue"
                        HorizontalAlignment="Center"
                        Margin="0,5,0,20"/>

                </StackPanel>

            </ScrollViewer>

        </Grid>

    </Grid>

</Page>
    
    
    