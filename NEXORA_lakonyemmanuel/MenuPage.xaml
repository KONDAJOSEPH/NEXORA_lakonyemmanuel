<Page
    x:Class="NEXORA_lakonyemmanuel.MenuPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NEXORA_lakonyemmanuel"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="White">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Background="#0B1930"
              Padding="30,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Background="#E3BB5F"
                Width="40"
                Height="40"
                CornerRadius="5"
                VerticalAlignment="Center">

                <TextBlock
                    Text="N"
                    FontSize="24"
                    FontWeight="Bold"
                    Foreground="White"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>

            </Border>

            <TextBlock
                Grid.Column="1"
                Text="NEXORA"
                Foreground="White"
                FontSize="30"
                FontWeight="Bold"
                VerticalAlignment="Center"
                Margin="10,0,0,0"/>

            <TextBlock
                Grid.Column="2"
                Text="E-Commerce Training Portal"
                FontSize="18"
                Foreground="White"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>

            <TextBlock
                Grid.Column="3"
                Text="Customer"
                Foreground="White"
                FontSize="18"
                VerticalAlignment="Center"
                Margin="20,0,20,0"/>

            <Button
                Grid.Column="4"
                x:Name="txtlogout"
                Content="LOGOUT"
                Foreground="#E3BB5F"
                Background="Transparent"
                VerticalAlignment="Center"/>

        </Grid>

        <ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <StackPanel
                Width="950"
                HorizontalAlignment="Center"
                Margin="30,40,30,40">

                <TextBlock
                    Text="Welcome to the NEXORA Training Portal"
                    FontSize="40"
                    FontWeight="Bold"
                    Foreground="#0B1930"
                    HorizontalAlignment="Center"/>

                <TextBlock
                    Text="Complete the available assessments to demonstrate your e-commerce knowledge"
                    FontSize="18"
                    Foreground="CadetBlue"
                    HorizontalAlignment="Center"
                    Margin="0,15,0,0"/>

                <TextBlock
                    Text="Available Assessment"
                    FontSize="18"
                    Foreground="#CC9C2D"
                    HorizontalAlignment="Center"
                    Margin="0,45,0,0"/>

                <TextBlock
                    Text="E-Commerce Knowledge Quiz"
                    FontSize="40"
                    FontWeight="Bold"
                    Foreground="#0B1930"
                    HorizontalAlignment="Center"
                    Margin="0,15,0,0"/>

                <TextBlock
                    Text="Test your understanding of online retail operations, products, customer service, orders, payments and delivery."
                    FontSize="18"
                    Foreground="CadetBlue"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="20,15,20,0"/>

                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,45,0,0"
                    Spacing="100">

                    <StackPanel
                        Orientation="Vertical"
                        Width="150"
                        HorizontalAlignment="Center">

                        <TextBlock
                            Text="20"
                            FontSize="32"
                            FontWeight="Bold"
                            Foreground="#0B1930"
                            HorizontalAlignment="Center"/>

                        <TextBlock
                            Text="Questions"
                            FontSize="18"
                            Foreground="CadetBlue"
                            HorizontalAlignment="Center"
                            Margin="0,5,0,0"/>

                    </StackPanel>

                    <StackPanel
                        Orientation="Vertical"
                        Width="150"
                        HorizontalAlignment="Center">

                        <TextBlock
                            Text="20"
                            FontSize="32"
                            FontWeight="Bold"
                            Foreground="#0B1930"
                            HorizontalAlignment="Center"/>

                        <TextBlock
                            Text="Minutes"
                            FontSize="18"
                            Foreground="CadetBlue"
                            HorizontalAlignment="Center"
                            Margin="0,5,0,0"/>

                    </StackPanel>

                    <StackPanel
                        Orientation="Vertical"
                        Width="150"
                        HorizontalAlignment="Center">

                        <TextBlock
                            Text="1"
                            FontSize="32"
                            FontWeight="Bold"
                            Foreground="#0B1930"
                            HorizontalAlignment="Center"/>

                        <TextBlock
                            Text="Attempt"
                            FontSize="18"
                            Foreground="CadetBlue"
                            HorizontalAlignment="Center"
                            Margin="0,5,0,0"/>

                    </StackPanel>

                </StackPanel>

                <Button Content="START E-COMMERCE QUIZ"
                        HorizontalAlignment="Center"
                        Margin="0,30,0,0"
                        Background="#CC9C2D"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="btnstart_Click"
                        />

                <TextBlock
                    Text="The assessment covers product knowledge, online orders, payment, delivery, returns and customer service."
                    FontSize="18"
                    Foreground="#0B1930"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="30,45,30,0"/>

                <TextBlock
                    Text="Assessment Instructions"
                    FontSize="22"                    
                    Foreground="DarkRed"
                    HorizontalAlignment="Left"
                    Margin="0,35,0,0"/>

                <TextBlock
                    Text="Read each quation carefully. Select one answer and proceed to the next question. Your final score will be displayed when the assessment is completed."
                    FontSize="18"
                    Foreground="DarkRed"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="0,15,0,0"/>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Page>